# Copy to .env and adjust for your machine.
# PostgreSQL is the supported database for this project.
DATABASE_URL=postgresql+psycopg://gully:gully@localhost:5432/gullyscore

# Flask session/cookie signing key. Generate a random value for any shared deploy.
GULLY_SECRET_KEY=change-me-to-a-random-value

# Comma separated list of allowed browser origins for the API.
# "*" is convenient for local development; restrict it in production.
CORS_ORIGINS=*

# Optional: port used by `python wsgi.py`
PORT=5000

# Optional: run the test suite against PostgreSQL instead of the default
# throwaway SQLite database.
# TEST_DATABASE_URL=postgresql+psycopg://gully:gully@localhost:5432/gullyscore_test

# --- Production authentication -------------------------------------------------
# Local development and the test suite leave this false. Set true in production.
AUTH_REQUIRED=false
# The first account is always allowed. Keep this false after bootstrapping.
ALLOW_REGISTRATION=false
SESSION_COOKIE_SECURE=false
# Use Lax for same-origin hosting. Cross-site frontend/API deployments need None
# plus HTTPS and SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=Lax
SESSION_DAYS=7
# Enable only behind a trusted reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false

# --- Rate limiting (process-local) ---------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_SCORING_REQUESTS=300
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_WINDOW=60
RATE_LIMIT_SCORING_WINDOW=60
RATE_LIMIT_AUTH_WINDOW=60
